rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección modular del portafolio (/portfolio/...)
    match /portfolio/{document=**} {
      // Lectura pública para cualquier visitante
      allow read: if true;

      // Escritura permitida para el administrador autenticado
      allow write: if request.auth != null;
    }

    // Regla de respaldo para desarrollo (si aún estás configurando Auth, puedes descomentar la siguiente línea):
    // match /portfolio/{document=**} { allow read, write: if true; }

    // Bloqueo por defecto para cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
